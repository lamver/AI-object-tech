{{- bos_token -}}
{%- if messages[0]['role'] == 'system' -%}
    {{- '<|system|>\n' + messages[0]['content'] + '\n' -}}
    {%- set loop_messages = messages[1:] -%}
{%- else -%}
    {{- loop_messages = messages -}}
{%- endif -%}
{%- for message in loop_messages -%}
    {{- '<|' + message['role'] + '|>\n' + message['content'] + '\n' -}}
{%- endfor -%}
{%- if add_generation_prompt -%}
    {{- '<|assistant|>\n' -}}
{%- endif -%}